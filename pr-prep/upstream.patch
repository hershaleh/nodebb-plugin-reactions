+		margin-top: 0.25rem;
+		color: inherit;
+		text-decoration: underline;
+	}
+
+	&.below .reactions-users-popup-arrow {
+		bottom: auto;
+		top: -0.4rem;
+		border-width: 0 0.4rem 0.4rem;
+		border-color: transparent transparent var(--bs-tooltip-bg, #000);
